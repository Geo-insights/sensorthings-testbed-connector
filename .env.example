CONNECTOR_BRIDGE_PAYLOAD_PATH=
MONITORING_MQTT_ENABLED=false
MONITORING_MQTT_HOST=
MONITORING_MQTT_PORT=1883
MONITORING_MQTT_TOPIC=monitoring/readings/bridge
MONITORING_MQTT_USERNAME=
MONITORING_MQTT_PASSWORD=
MONITORING_MQTT_TLS=false
SENSORTHINGS_BASE_URL=
# Multiple targets: plain strings (v1.1) or JSON objects with version + per-target auth.
# Plain string format (comma-separated or JSON list):
#   SENSORTHINGS_BASE_URLS=https://server1/v1.1,https://server2/v1.1
# JSON object format (supports v2.0 and per-target auth):
#   SENSORTHINGS_BASE_URLS=[{"url":"https://server1/v1.1","version":"v1.1"},{"url":"https://v2-server/v2.0","version":"v2.0","label":"frost-v2-demo"}]
# Object fields: url (required), version (default "v1.1"), label, auth_username, auth_password, auth_token
# Per-target auth falls back to global SENSORTHINGS_AUTH_* when not set.
SENSORTHINGS_BASE_URLS=
SENSORTHINGS_THINGS_PATH=/Things
SENSORTHINGS_LOCATIONS_PATH=/Locations
SENSORTHINGS_SENSORS_PATH=/Sensors
SENSORTHINGS_OBSERVED_PROPERTIES_PATH=/ObservedProperties
SENSORTHINGS_DATASTREAMS_PATH=/Datastreams
SENSORTHINGS_OBSERVATIONS_PATH=/Observations
SENSORTHINGS_PROJECTS_PATH=/Projects
SENSORTHINGS_ACTUATORS_PATH=/Actuators
SENSORTHINGS_TASKING_CAPABILITIES_PATH=/TaskingCapabilities
SENSORTHINGS_TASKS_PATH=/Tasks
SENSORTHINGS_DEFAULT_PROJECT_NAME=
SENSORTHINGS_DEFAULT_PROJECT_ID=
SENSORTHINGS_DEFAULT_PROJECT_DESCRIPTION=
SENSORTHINGS_DEFAULT_PROJECT_PUBLIC=true
SENSORTHINGS_SITE_PROJECTS_JSON=
SENSORTHINGS_SITE_TASKING_JSON=
SENSORTHINGS_TASKING_ALLOWED_COMMANDS=
SENSORTHINGS_AUTH_TOKEN=
SENSORTHINGS_AUTH_USERNAME=
SENSORTHINGS_AUTH_PASSWORD=
SENSORTHINGS_ENTITY_NAME_PREFIX=
SENSORTHINGS_DATASTREAM_IDS_JSON=
SENSORTHINGS_REGISTERED_ENTITIES_PATH=data/registered_entities.json
SENSORTHINGS_FAILED_OBSERVATIONS_PATH=data/failed_observations.jsonl
SENSORTHINGS_REQUEST_TIMEOUT_SECONDS=15
CONNECTOR_NAME=UrbanAdapt SensorThings Connector
PUBLIC_BASE_URL=http://localhost:8000
# FROST_PUBLIC_BASE_URL=
# FROST_INTERNAL_BASE_URL=
SENSOR_CONFIG_DIR=config/sites
DEBUG=false

# --- Kafka / TGV Office Lab source ---
# Set KAFKA_TGV_ENABLED=true and fill in credentials to activate POST /connector/kafka-push.
# Credentials are available in the Confluent Cloud console for the TGV project.
KAFKA_TGV_ENABLED=false
KAFKA_TGV_BOOTSTRAP_SERVERS=pkc-e8mp5.eu-west-1.aws.confluent.cloud:9092
KAFKA_TGV_API_KEY=
KAFKA_TGV_API_PASSWORD=
KAFKA_TGV_SCHEMA_REGISTRY_URL=https://psrc-1w11j.eu-central-1.aws.confluent.cloud
KAFKA_TGV_SCHEMA_REGISTRY_USERNAME=
KAFKA_TGV_SCHEMA_REGISTRY_PASSWORD=
KAFKA_TGV_CONSUMER_GROUP=gv_sa-j3r03zm_mathis_van_der_voordt
KAFKA_TGV_CLIENT_ID_CONSUMER=geo-insights-consumer
KAFKA_TGV_TOPIC=tud_gv_officelab-climate
# Optional: override measurement_id → FROST entity mapping as JSON.
# Key format: "<device_id>/<measurement_id>" for exact match, or "*/<measurement_id>" for wildcard.
# Example: {"*/temperature":{"thing_name":"TGV Office Lab","sensor_id":"tgv-officelab-climate","observed_property":"temperature","observed_property_name":"Air temperature","unit":"Cel"}}
KAFKA_TGV_POLL_SECONDS=300
KAFKA_TGV_DEVICE_MAPPING_JSON=

# --- Ohnics air quality source ---
# Outdoor air quality sensors in Delft (SamenMeten network).
# The 5min.json endpoint returns latest readings for all sensors.
# Only sensors with the configured prefix (de- = Delft) are ingested.
OHNICS_ENABLED=false
OHNICS_API_URL=https://ohnics.online/5min.json
OHNICS_POLL_SECONDS=300
OHNICS_SENSOR_PREFIX=de-

# --- Levellog / CARS Online groundwater source ---
# Groundwater level sensors via the CARS Online OData API.
# Uses OAuth2 client credentials for authentication.
# LEVELLOG_INSTALLATION_IDS is a comma-separated list of CARS installation UUIDs.
LEVELLOG_ENABLED=false
LEVELLOG_API_URL=https://cars-api.carsonline.eu
LEVELLOG_TOKEN_URL=https://cars-api.carsonline.eu/token
LEVELLOG_CLIENT_ID=
LEVELLOG_CLIENT_SECRET=
LEVELLOG_INSTALLATION_IDS=
# Optional: per-installation name + coordinates as JSON array.
# Format: [{"id": "<uuid>", "name": "Waterstraat", "lat": 51.99, "lon": 4.37}, ...]
# Falls back to LEVELLOG_INSTALLATION_IDS when not set.
LEVELLOG_INSTALLATIONS_JSON=
LEVELLOG_POLL_SECONDS=900

# --- Monitoring module direct push ---
# Push readings directly to the monitoring module after FROST push (bypasses
# the 5-minute FROST polling delay). Set the same key as CONNECTOR_PUSH_KEY
# in the monitoring module's .env.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
MONITORING_PUSH_URL=
MONITORING_PUSH_KEY=

# --- Observation push reliability ---
# Batch pushes via the SensorThings CreateObservations (dataArray) extension.
FROST_BATCH_PUSH_ENABLED=true
# Max observations per CreateObservations request (avoid server timeouts).
FROST_BATCH_MAX_OBSERVATIONS=500
# Read timeout for batch requests (seconds).
FROST_BATCH_TIMEOUT_SECONDS=60
# Circuit breaker: skip a target after N consecutive failed push cycles.
FROST_CB_FAILURE_THRESHOLD=3
# Circuit breaker: cooldown seconds before retrying an open circuit.
FROST_CB_COOLDOWN_SECONDS=600
# Scheduled replay of the failed-observations dead-letter queue.
FAILED_REPLAY_ENABLED=true
FAILED_REPLAY_INTERVAL_SECONDS=900
FAILED_REPLAY_MAX_LINES=500
# Probe for an existing (Datastream, phenomenonTime) before re-posting a
# dead-letter entry, so replay can't duplicate on servers that don't enforce
# observation uniqueness. The hot streaming path stays probe-free.
FROST_REPLAY_DEDUP_PROBE=true
