# MCP Server environment variables
# Copy to /opt/geo-insights/mcp.env on the server and fill in credentials

FROST_BASE_URL=http://frost:8080/FROST-Server/v1.1
FROST_AUTH_USERNAME=
FROST_AUTH_PASSWORD=
MCP_RATE_LIMIT_RPM=100
MCP_REQUEST_TIMEOUT_SECONDS=15
MCP_CIRCUIT_BREAKER_THRESHOLD=5
MCP_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300
MCP_PORT=8030
