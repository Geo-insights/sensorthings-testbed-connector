# MCP Server environment variables
# Copy to /opt/geo-insights/mcp.env on the server and fill in credentials

FROST_BASE_URL=http://frost:8080/FROST-Server/v1.1
FROST_AUTH_USERNAME=
FROST_AUTH_PASSWORD=
MCP_RATE_LIMIT_RPM=100
MCP_REQUEST_TIMEOUT_SECONDS=15
MCP_CIRCUIT_BREAKER_THRESHOLD=5
MCP_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300
MCP_PORT=8030

# Auth (optional — leave SUPABASE_JWT_SECRET empty to disable auth entirely)
SUPABASE_JWT_SECRET=
SUPABASE_URL=https://upjxsqjnrnamsexrlkqx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
MCP_RATE_LIMIT_AUTHENTICATED_RPM=500

# Premium tool gating (false = all tools free, true = enforce scope checks)
MCP_PREMIUM_GATING=false

# Stripe (leave empty to disable payment endpoints)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=https://geo-insights.nl/payment/success
STRIPE_CANCEL_URL=https://geo-insights.nl/pricing
