      "name": "location_description",
      "doc": "Location description.",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "latitude",
      "doc": "Latitude in decimal degrees of the device location (GPS coordinates).",
      "type": [
        "null",
        "float"
      ],
      "default": null
    },
    {
      "name": "longitude",
      "doc": "Longitude in decimal degrees of the device location (GPS coordinates).",
      "type": [
        "null",
        "float"
      ],
      "default": null
    },
    {
      "name": "altitude",
      "doc": "Altitude in meters above the mean sea level.",
